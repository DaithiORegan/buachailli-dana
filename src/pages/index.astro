---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
import dates from '../data/live-dates.json';
const highlights=dates.slice().sort((a,b)=>a.date.localeCompare(b.date)).slice(0,3);
const dateLabel=(date:string)=>new Date(date+'T12:00:00Z').toLocaleDateString('en-IE',{day:'numeric',month:'long',year:'numeric',timeZone:'Europe/London'});
---
<Layout>
<main id="main">
  <section class="hero booking-hero band-hero" aria-labelledby="hero-title">
    <img class="hero-image" src={site.heroImage} alt="Illustrative photograph of an acoustic guitar" width="1800" height="1200" fetchpriority="high" />
    <div class="hero-wash"></div>

    <h1 id="hero-title">BUACHAILLI<span>DANA</span></h1>
    <div class="booking-hero-bottom"><div><p>Kerry-based wedding band and solo musician.<br />Available throughout Ireland.</p><p class="hero-band">Two- to five-piece band, based on your venue and requirements. Solo bookings with <strong>Daithí O’Regan</strong> also available.</p></div><div class="hero-buttons"><a class="pill cream" href="#contact" data-format="Band — not sure yet">Check your date ↗</a><a class="pill outline" href="#solo">Solo bookings ↗</a></div></div>
  </section>

  <section id="band" class="section booking-section band-section" aria-labelledby="band-title"><div class="booking-copy"><h2 id="band-title">BUACHAILLI<br /><span class="heading-line">Dana</span></h2><p>Book Kerry-based wedding band Buachailli Dana for weddings, day twos, birthdays and corporate events throughout Ireland.</p><a class="text-link" href="/wedding-band/">Wedding band information ↗</a><p>Professional musicians with extremely competitive pricing. Choose a two- to five-piece lineup based on your venue and requirements, with a setlist catered to the occasion. Include your date and venue when asking about availability.</p><a class="pill cream" href="#contact" data-format="Band — not sure yet">Enquire about the band ↗</a><a class="text-link" href="/setlist/">View setlist ↗</a></div><div class="booking-image"><img src="/images/stage.jpg" alt="Illustrative stage photograph; not Buachailli Dana" width="900" height="900" loading="lazy" /></div></section>
  <section id="solo" class="section booking-section" aria-labelledby="solo-title"><div class="booking-image"><img src="/images/guitar.jpg" alt="Illustrative acoustic guitar photograph" width="900" height="900" loading="lazy" /></div><div class="booking-copy"><h2 id="solo-title">DAITHÍ<br /><span class="heading-line">O’Regan</span></h2><p>Solo musician Daithí O’Regan is based in Kerry and available throughout Ireland for your wedding, day two, birthday or corporate event.</p><a class="text-link" href="/solo-musician/">Solo musician information ↗</a><p>Setlist catered to the venue and occasion. Get in touch with your date, venue and preferred timings to discuss your booking.</p><a class="pill wine" href="#contact" data-format="Solo">Enquire about a solo booking ↗</a><a class="text-link" href="/setlist/">View setlist ↗</a></div></section>
  <section id="setlist" class="section setlist-summary" aria-labelledby="setlist-title"><div><span class="eyebrow">SETLIST</span><h2 id="setlist-title">CHOOSE YOUR<br /><span class="heading-line">setlist.</span></h2></div><div><p>The setlist is catered to the venue and occasion. Include any songs you’d like to hear when you enquire.</p><a class="pill wine" href="/setlist/">Browse the setlist ↗</a></div></section>
  <section id="live" class="section dates-preview" aria-labelledby="dates-preview-title"><div class="section-heading"><div><span class="eyebrow">LIVE DATES / 2027</span><h2 id="dates-preview-title">HEAR US<br /><span class="heading-line">live.</span></h2></div><a class="pill wine" href="/live/">View all dates ↗</a></div><div class="gig-list">{highlights.map(gig=><article class="gig-row"><time datetime={gig.date}>{dateLabel(gig.date)}</time><div><h3>{gig.venue}</h3><p>{gig.location}</p></div><span class="gig-lineup">{gig.lineup || 'Lineup to be confirmed'}</span></article>)}</div></section>
  <section id="about" class="section booking-about" aria-labelledby="about-title"><span class="eyebrow">ABOUT</span><h2 id="about-title">BUACHAILLI DANA<br /><span class="heading-line">&amp; Daithí O’Regan</span></h2><p>{site.bio}</p></section>
  <section class="section faq-section" aria-labelledby="faq-title"><div><span class="eyebrow">BOOKING INFORMATION</span><h2 id="faq-title">COMMON<br /><span class="heading-line">questions.</span></h2></div><div class="faqs"><details><summary>What booking options are available?</summary><p>Buachailli Dana as a two- to five-piece band, based on the venue and your requirements, or solo bookings with Daithí O’Regan.</p></details><details><summary>What types of events do you play?</summary><p>Weddings, day twos, birthdays and corporate events.</p></details><details><summary>Can the setlist be tailored?</summary><p>Yes. The setlist is catered to the venue and occasion. Mention any preferences or song requests in your enquiry.</p></details><details><summary>How much does a booking cost?</summary><p>We offer extremely competitive pricing. Get in touch with your date, venue and requirements for a quote for the right lineup.</p></details><details><summary>What should I include in an enquiry?</summary><p>Your event date, venue, event type, preferred lineup and approximate performance times. Prices, availability and arrangements can then be discussed directly.</p></details></div></section>
  <section id="contact" class="section booking-contact" aria-labelledby="contact-title"><div><span class="eyebrow light">CONTACT</span><h2 id="contact-title">CHECK<br /><span class="heading-line">availability.</span></h2><p>For Buachailli Dana or solo bookings.</p><a class="contact-email" href={'mailto:'+site.email}>{site.email}</a><a class="contact-phone" href={'tel:'+site.phoneLink}>{site.phone}</a><p class="contact-help">Please include your date, venue and preferred lineup.</p></div><form class="enquiry-form" data-access-key={site.formAccessKey}><input type="checkbox" name="botcheck" hidden tabindex="-1" autocomplete="off" aria-hidden="true" /><div class="form-row"><label>Your name<input name="name" autocomplete="name" required /></label><label>Your email<input name="email" type="email" autocomplete="email" required /></label></div><div class="form-row"><label>Event date<input name="date" type="date" required /></label><label>Event type<select name="event" required><option value="">Select an event</option>{site.events.map(e=><option>{e}</option>)}<option>Other</option></select></label></div><label>Venue / location<input name="venue" required /></label><label>Booking option<select name="format" id="booking-format" required><option value="">Select an option</option>{site.lineups.map(lineup=><option>{'Band — '+lineup.toLowerCase()}</option>)}<option>Band — not sure yet</option><option>Solo</option></select></label><label>Timings, song requests or other details<textarea name="message" rows="4"></textarea></label><button class="pill cream" type="submit">Send enquiry ↗</button><p class="form-note">Your enquiry is delivered securely through Web3Forms. Your contact details are used to respond to your booking enquiry. You can also email or call directly.</p><p class="form-feedback" role="status" aria-live="polite"></p></form></section>
</main>
<script>
  import { sendBooking } from '../lib/booking-delivery.mjs';
  const form=document.querySelector<HTMLFormElement>('.enquiry-form');
  document.querySelectorAll<HTMLAnchorElement>('[data-format]').forEach(link=>link.addEventListener('click',()=>{const select=document.querySelector<HTMLSelectElement>('#booking-format');if(select)select.value=link.dataset.format || '';}));
  let sending=false;
  form?.addEventListener('submit',async event=>{
    event.preventDefault();
    if(sending || !form.reportValidity())return;
    const status=form.querySelector<HTMLElement>('.form-feedback');
    const button=form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if(!form.dataset.accessKey?.trim()){
      if(status)status.textContent='Online enquiries are temporarily unavailable. Please email or call using the contact details shown here.';
      return;
    }
    sending=true;
    form.setAttribute('aria-busy','true');
    if(button){button.disabled=true;button.textContent='Sending…';}
    if(status)status.textContent='Sending your enquiry…';
    try {
      const values=Object.fromEntries(new FormData(form).entries());
      await sendBooking(values,form.dataset.accessKey);
      if(status)status.textContent='Thank you. Your booking enquiry has been submitted. We’ll be in touch using the email address you provided.';
      form.reset();
    }catch {
      if(status)status.textContent='We couldn’t confirm that your enquiry was sent. Your details are still in the form. Please try again or contact us by email or phone.';
    }finally{
      sending=false;
      form.removeAttribute('aria-busy');
      if(button){button.disabled=false;button.textContent='Send enquiry ↗';}
    }
  });
</script>
</Layout>
