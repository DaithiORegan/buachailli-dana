---
import Layout from '../layouts/Layout.astro';
import site from '../data/site.json';
---
<Layout title={'Booking Information | Buachailli Dana & '+site.name} description="Contact Kerry-based wedding band Buachailli Dana or solo musician Daithí O’Regan for availability, lineups and quotes for events throughout Ireland.">
<main id="main"><section class="section press-heading"><a class="text-link" href="/">← Back to bookings</a><span class="eyebrow">BAND &amp; SOLO BOOKINGS</span><h1>BOOKING<br /><span class="heading-line">information.</span></h1><p class="press-lead">Buachailli Dana · Daithí O’Regan</p></section><section class="section press-grid"><div><span class="eyebrow">PERFORMANCE OPTIONS</span><h2>BAND<br /><span class="heading-line">or solo.</span></h2><p>{site.bio}</p><p>When enquiring, include your date, venue, event type, preferred lineup and approximate performance times.</p><a class="pill wine" download href="/downloads/artist-information.txt">Download booking information ↓</a></div><div class="press-contact"><span class="eyebrow">CONTACT DAITHÍ</span><a class="contact-email" href={'mailto:'+site.email}>{site.email}</a><a class="contact-phone" href={'tel:'+site.phoneLink}>{site.phone}</a><hr /><span class="eyebrow">SETLIST</span><p>Setlist catered to the venue and occasion.</p><p><a class="text-link" href="/setlist/">View setlist ↗</a></p><p><a class="text-link" href="/#contact">Prepare a booking enquiry ↗</a></p></div></section></main>
</Layout>
